# ============================================================
# Beam-Flink Pipeline configuration example.
# Copy to .env and edit. Never commit .env to version control.
# All values shown are the LOCAL defaults from PipelineConfig.
# ============================================================

# ── Kafka ──────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=beam-ecommerce-consumer

# Source topics consumed by KafkaIO
KAFKA_TOPIC_ORDERS=orders
KAFKA_TOPIC_PAYMENTS=payments
KAFKA_TOPIC_CUSTOMER=customer-events

# Sink topics
KAFKA_TOPIC_DLQ=dlq
KAFKA_TOPIC_ALERTS=alerts
KAFKA_TOPIC_METRICS=metrics-output
KAFKA_TOPIC_CART_ABANDONMENT=cart-abandonment

# Consumer offset reset strategy.
# LOCAL default: earliest (replay full topic in dev).
# Non-LOCAL default: latest (avoid reprocessing on restart).
KAFKA_AUTO_OFFSET_RESET=earliest

# Producer timeout settings. LOCAL defaults are intentionally short so
# tests/local runs fail fast. Increase for production (120000/30000/60000).
KAFKA_PRODUCER_DELIVERY_TIMEOUT_MS=5000
KAFKA_PRODUCER_REQUEST_TIMEOUT_MS=3000
KAFKA_PRODUCER_MAX_BLOCK_MS=3000

# ── Kafka Security (leave empty to disable; set all for SASL/SSL) ──
# KAFKA_SECURITY_PROTOCOL=SASL_SSL
# KAFKA_SASL_MECHANISM=PLAIN
# KAFKA_SASL_JAAS_CONFIG=org.apache.kafka.common.security.plain.PlainLoginModule required username="user" password="pass";
# KAFKA_SSL_TRUSTSTORE_LOCATION=/etc/kafka/certs/truststore.jks
# KAFKA_SSL_TRUSTSTORE_PASSWORD=changeit

# ── PostgreSQL ─────────────────────────────────────────────
POSTGRES_URL=jdbc:postgresql://localhost:5432/ecommerce
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_POOL_MIN=2
POSTGRES_POOL_MAX=5
POSTGRES_WRITE_BATCH_SIZE=200
# POSTGRES_SSL_MODE=disable   # set to 'require' or 'verify-full' in production

# ── Object Storage ─────────────────────────────────────────
USE_LOCAL_OBJECT_STORAGE=true
LOCAL_OBJECT_STORAGE_PATH=./data/events
OBJECT_STORAGE_BUCKET=ecommerce-events
# OBJECT_STORAGE_SCHEME=file   # file | gs | s3  (default: file)

# ── Pipeline / Flink tuning ────────────────────────────────
CHECKPOINT_DIR=./data/checkpoints
CHECKPOINT_INTERVAL_MS=60000
FLINK_PARALLELISM=2
WATERMARK_INTERVAL_MS=1000
# Max seconds the pipeline will wait behind the realtime clock for late data
WATERMARK_MAX_DELAY_SECONDS=30
# How long past the window end to accept late events (seconds)
ALLOWED_LATENESS_SECONDS=600
# Time-to-live for dedup ValueState per event_id (seconds)
DEDUPLICATION_TTL_SECONDS=86400
# Maximum age of an event to be accepted (days). Older events go to DLQ.
MAX_EVENT_AGE_DAYS=7

# ── Risk Detection ─────────────────────────────────────────
# Sliding window length for per-minute failure/velocity buckets
RISK_LOOKBACK_MINUTES=60
# Minimum payment failures within the window to contribute to score
RISK_FAILURE_THRESHOLD=3
# Minimum order attempts within the window to contribute to score
RISK_VELOCITY_THRESHOLD=10
# Risk score at or above which a signal is emitted (0.0–1.0)
EMIT_AT=0.5
# Risk score at or above which the signal is marked escalated (0.0–1.0)
ESCALATE_AT=0.8

# ── Environment ────────────────────────────────────────────
# LOCAL  → fail-open gated, earliest offset, short producer timeouts
# PRODUCTION → enforces password/host/storage constraints
ENVIRONMENT=LOCAL

# Fail-open: when true, sink errors are logged and skipped (LOCAL only).
# Never set to true in PRODUCTION.
SINK_FAIL_OPEN=false
